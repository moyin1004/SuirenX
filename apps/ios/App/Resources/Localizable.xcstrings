    "ui.sign_out_before_switching_accounts_changing_or_deleting_an_address": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换账号前请先退出。更改或删除地址不会清除账号。退出只清除此设备凭据，已签发令牌仍可在其 30 天有效期内使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out before switching accounts. Changing or deleting an address does not clear the account. Signing out only removes credentials from this device; issued tokens remain valid for their 30-day lifetime."
          }
        }
      }
    },
