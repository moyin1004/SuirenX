          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS and iPadOS decide when background tasks run. The frequency is a preference; power, network and Background App Refresh settings may delay sync. You can always sync manually."
          }
        }
      }
    },
