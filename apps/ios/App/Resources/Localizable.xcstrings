    "ui.the_system_decides_when_background_tasks_run_exact_timing_is": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统决定后台运行时机，无法保证准点。修改后模式会短暂合并连续修改，并申请约 15 分钟后的后台补偿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system decides when background tasks run; exact timing is not guaranteed. Sync after changes briefly combines consecutive edits and requests a background retry in about 15 minutes."
          }
        }
      }
    },
    "ui.resolve_conflicts_": {
      "extractionState": "manual",
