      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相同编号的数据差异将进入显式冲突处理。切换同步目标会重建目标专属版本与游标，本机记录和删除记录保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records with the same ID and different content require explicit conflict resolution. Switching sync targets resets target-specific versions and cursors while keeping local records and tombstones."
          }
        }
      }
    },
