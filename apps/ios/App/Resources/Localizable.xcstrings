          }
        }
      }
    },
    "ui.only_conflicting_records_pause_other_records_continue_syncing_the_current": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅暂停发生冲突的记录；其他记录继续同步。双方修改时间不可从当前协议核实。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only conflicting records pause; other records continue syncing. The current protocol cannot verify edit timestamps on both sides."
          }
        }
      }
    },
