// Shared Android/iOS/Web product version. Change only MARKETING_VERSION for a release.
MARKETING_VERSION = 0.1.3
// IDE builds use a stable baseline; scripts/package.py allocates package numbers.
SUIRENX_BUILD_NUMBER = 4
CURRENT_PROJECT_VERSION = 1.0.4
// Keep subsequent IDE installs at the latest locally reserved package number.
#include? ".suirenx-build/development.xcconfig"
